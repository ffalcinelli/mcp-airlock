{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "mcpServers": {
    "mcp-airlock-local": {
      "command": "./target/debug/mcp-airlock",
      "args": [],
      "env": {
        "MCP_AIRLOCK_REMOTE_MCP_URL": "http://localhost:8081/rpc",
        "MCP_AIRLOCK_OIDC_CLIENT_ID": "mcp-airlock",
        "MCP_AIRLOCK_OIDC_ISSUER": "http://localhost:8080/realms/mcp",
        "MCP_AIRLOCK_OIDC_REDIRECT_URL": "http://127.0.0.1:8082/callback",
        "MCP_AIRLOCK_LOG_LEVEL": "debug",
        "MCP_AIRLOCK_AUTH_SCHEME": "dpop"
      },
      "trust": true
    }
  }
}
